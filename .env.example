# Keep this exact variable name; it matches the collector's configuration.
BILI_COKKIES=
# Comma-separated room IDs. Omit to discover currently live rooms.
BILI_ROOM_IDS=21756924,732
# 0 monitors continuously; positive seconds include connection and reconnect waits.
BILI_CAPTURE_SECONDS=0
# Optional: directory for append-only JSONL segments, outside regression fixtures.
BILI_CAPTURE_OUTPUT=.captures/21756924-732
# Rotate files at this many UTF-8 bytes (default: 64 MiB).
BILI_CAPTURE_MAX_BYTES=67108864
# Optional: automatically stop examples/live.ts after this many seconds (0 waits for Ctrl+C).
BILI_EXAMPLE_SECONDS=0
